{
  "name": "cedar-term-picker",
  "description": "A reusable Web Component for choosing what constrains a CEDAR field.",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:production": "ng build --configuration=production",
    "test": "ng test",
    "test:watch": "ng test --watch",
    "lint": "ng lint",
    "typecheck": "tsc -p tsconfig.eslint.json --noEmit",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "test:ci": "npm run lint && npm run typecheck && npm test && npm run build:production && npm run test:browser:prebuilt",
    "test:browser": "npm run build:production && npm --prefix browser test",
    "test:browser:prebuilt": "npm --prefix browser test"
  },
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/elements": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.9.2",
    "angular-eslint": "^22.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^16.5.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
