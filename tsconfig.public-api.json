/*
  Emits the declarations the npm package ships.

  `src/app/term-picker-public-api.ts` and the one file it re-exports from, which
  carries no imports of its own. Compiling only those is what keeps the published
  `.d.ts` free of paths that exist in this repository and not in the package: add
  an import of anything else and this build fails rather than shipping a broken
  declaration.
*/
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist-types",
    "rootDir": "./src/app",
    "types": []
  },
  "files": ["src/app/term-picker-public-api.ts"]
}
