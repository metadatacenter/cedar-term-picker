/*
  Compiler options shared by every program in the repository. The three configs that
  extend it differ only in which files they include and which ambient types they allow.
*/
{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "dom"],
    /*
     * Set explicitly rather than left to TypeScript 6's default, so a later major
     * cannot move it without someone deciding to. The repository is new, so this
     * costs nothing to hold; it is only ever expensive to adopt late.
     */
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "importHelpers": true,
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [{ "path": "./tsconfig.app.json" }, { "path": "./tsconfig.spec.json" }]
}
